<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

        <!-- Top App Bar -->
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBarLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@color/blue_primary"
            android:elevation="4dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <!-- Duck + BathChat title on the left -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_gravity="start">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/chatgpt_image_mar_28__2026__04_55_44_pm"
                        android:contentDescription="BathChat logo" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BathChat"
                        android:textColor="@android:color/white"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_marginStart="8dp" />

                </LinearLayout>

            </androidx.appcompat.widget.Toolbar>

        </com.google.android.material.appbar.AppBarLayout>


        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/chatgpt_image_mar_28__2026__04_43_16_pm"
            app:layout_constraintTop_toBottomOf="@id/appBarLayout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:fillViewport="true">

            <!-- Main content frame (switchable views) -->
            <FrameLayout
                android:id="@+id/contentFrame"
                android:layout_width="match_parent"
                android:layout_height="match_parent"

                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" >

                <LinearLayout
                    android:id="@+id/homeContainer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="188dp"
                        android:layout_marginBottom="16dp"
                        app:cardBackgroundColor="@color/semi_transparent_white"
                        app:cardCornerRadius="16dp">

                        <!-- Society Highlights -->
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:id="@+id/txtSoceityHighlightWrap"
                                android:paddingTop="5dp"
                                android:layout_gravity="start"

                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintStart_toStartOf="parent">

                                <ImageView
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:src="@drawable/fire_emoji"
                                    android:contentDescription="Fire Emoji"
                                    android:layout_marginStart="4dp"/>

                                <TextView
                                    android:id="@+id/txtSoceityHighlights"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/nunito_extralight"
                                    android:paddingStart="8dp"
                                    android:text="Society Highlights"
                                    android:textSize="18sp"
                                    android:textStyle="bold"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/txtSoceityHighlightsList"
                                android:layout_width="match_parent"
                                android:layout_height="150dp"
                                android:layout_marginTop="6dp"
                                android:orientation="vertical"
                                android:padding="16dp"

                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/txtSoceityHighlightWrap" >

                                <ScrollView
                                    xmlns:android="http://schemas.android.com/apk/res/android"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent">

                                    <TextView
                                        android:id="@+id/txtSoceityHighlightsYup"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textSize="20sp"/>
                                </ScrollView>
                            </LinearLayout>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- From Your Course -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="188dp"
                        android:layout_marginBottom="16dp"
                        app:cardBackgroundColor="@color/semi_transparent_white"
                        app:cardCornerRadius="16dp">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:id="@+id/txtFromYourCourseWrap"
                                android:paddingTop="5dp"
                                android:layout_gravity="start"

                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintStart_toStartOf="parent">

                                <ImageView
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:src="@drawable/cap_emjoi"
                                    android:contentDescription="Hat Emoji"
                                    android:layout_marginStart="4dp"/>

                                <!-- From Your Course -->
                                <TextView
                                    android:id="@+id/txtFromYourCourse"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/nunito_extralight"
                                    android:paddingStart="8dp"
                                    android:text="From Your Course"
                                    android:textSize="18sp"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent"
                                    android:textStyle="bold"/>
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/mealContainer"
                                android:layout_width="match_parent"
                                android:layout_height="150dp"
                                android:layout_marginTop="16dp"
                                android:orientation="horizontal"
                                android:padding="16dp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintHorizontal_bias="0.0"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/txtFromYourCourseWrap"
                                app:layout_constraintVertical_bias="0.6">
                            </LinearLayout>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="188dp"
                        android:layout_marginBottom="16dp"
                        app:cardBackgroundColor="@color/semi_transparent_white"
                        app:cardCornerRadius="16dp">
                        <!-- Trending Today -->
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <!-- Title Row -->
                            <LinearLayout
                                android:id="@+id/txtTrendingTodayWrap"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:paddingTop="5dp"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintStart_toStartOf="parent">

                                <ImageView
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:src="@drawable/megaphone_emoji"
                                    android:contentDescription="Megaphone Emoji"
                                    android:layout_marginStart="4dp"/>

                                <TextView
                                    android:id="@+id/txtTrendingToday"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/nunito_extralight"
                                    android:paddingStart="8dp"
                                    android:text="Trending Today"
                                    android:textSize="18sp"/>
                            </LinearLayout>

                            <!-- Scroll Section -->
                            <HorizontalScrollView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:scrollbars="none"
                                app:layout_constraintTop_toBottomOf="@id/txtTrendingTodayWrap"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toEndOf="parent">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal">

                                        <!-- Trending Item 1 -->
                                        <com.google.android.material.card.MaterialCardView
                                            android:layout_width="160dp"
                                            android:layout_height="180dp"
                                            android:layout_marginEnd="12dp"
                                            app:cardCornerRadius="16dp"
                                            app:cardElevation="4dp"
                                            android:backgroundTint="@android:color/white">

                                            <LinearLayout
                                                android:layout_width="match_parent"
                                                android:layout_height="match_parent"
                                                android:orientation="vertical"
                                                android:padding="12dp"
                                                android:gravity="center_horizontal">

                                                <ImageView
                                                    android:layout_width="60dp"
                                                    android:layout_height="60dp"
                                                    android:src="@drawable/ic_home_black_24dp"
                                                    android:layout_marginBottom="8dp"/>

                                                <TextView
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:text="AI Society"
                                                    android:textStyle="bold"
                                                    android:textSize="14sp"
                                                    android:gravity="center"/>

                                                <TextView
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:text="120 interested"
                                                    android:textSize="12sp"
                                                    android:textColor="#888888"
                                                    android:layout_marginTop="4dp"/>
                                            </LinearLayout>

                                        </com.google.android.material.card.MaterialCardView>

                                        <!-- Trending Item 2 -->
                                        <com.google.android.material.card.MaterialCardView
                                            android:layout_width="160dp"
                                            android:layout_height="180dp"
                                            android:layout_marginEnd="12dp"
                                            app:cardCornerRadius="16dp"
                                            app:cardElevation="4dp"
                                            android:backgroundTint="@android:color/white">

                                            <LinearLayout
                                                android:layout_width="match_parent"
                                                android:layout_height="match_parent"
                                                android:orientation="vertical"
                                                android:padding="12dp"
                                                android:gravity="center_horizontal">

                                                <ImageView
                                                    android:layout_width="60dp"
                                                    android:layout_height="60dp"
                                                    android:src="@drawable/ic_home_black_24dp"
                                                    android:layout_marginBottom="8dp"/>

                                                <TextView
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:text="Football Trials"
                                                    android:textStyle="bold"
                                                    android:textSize="14sp"
                                                    android:gravity="center"/>

                                                <TextView
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:text="90 attending"
                                                    android:textSize="12sp"
                                                    android:textColor="#888888"
                                                    android:layout_marginTop="4dp"/>
                                            </LinearLayout>

                                        </com.google.android.material.card.MaterialCardView>

                                        <!-- Trending Item 3 -->
                                        <com.google.android.material.card.MaterialCardView
                                            android:layout_width="160dp"
                                            android:layout_height="180dp"
                                            android:layout_marginEnd="12dp"
                                            app:cardCornerRadius="16dp"
                                            app:cardElevation="4dp"
                                            android:backgroundTint="@android:color/white">

                                            <LinearLayout
                                                android:layout_width="match_parent"
                                                android:layout_height="match_parent"
                                                android:orientation="vertical"
                                                android:padding="12dp"
                                                android:gravity="center_horizontal">

                                                <ImageView
                                                    android:layout_width="60dp"
                                                    android:layout_height="60dp"
                                                    android:src="@drawable/ic_home_black_24dp"
                                                    android:layout_marginBottom="8dp"/>

                                                <TextView
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:text="Night Out"
                                                    android:textStyle="bold"
                                                    android:textSize="14sp"
                                                    android:gravity="center"/>

                                                <TextView
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:text="200 going"
                                                    android:textSize="12sp"
                                                    android:textColor="#888888"
                                                    android:layout_marginTop="4dp"/>
                                            </LinearLayout>

                                        </com.google.android.material.card.MaterialCardView>

                                </LinearLayout>

                            </HorizontalScrollView>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Events This Week -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="188dp"
                        android:layout_marginBottom="16dp"
                        app:cardBackgroundColor="@color/semi_transparent_white"
                        app:cardCornerRadius="16dp">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:id="@+id/txtEventsThisWeekWrap"
                                android:paddingTop="5dp"
                                android:layout_gravity="start"

                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintStart_toStartOf="parent">

                                <ImageView
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:src="@drawable/celebration_emoji"
                                    android:contentDescription="Celebration Emoji"
                                    android:layout_marginStart="4dp"/>

                                <TextView
                                    android:id="@+id/txtEventsThisWeek"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/nunito_extralight"
                                    android:paddingStart="8dp"
                                    android:text="Events This Week"
                                    android:textSize="18sp"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent" />
                            </LinearLayout>

                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </androidx.cardview.widget.CardView>

                </LinearLayout>
            </FrameLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>